<?xml version="1.0"?>
<robot name="mini_humanoid_sim" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Very simple URDF for simulation/prototyping. Units: meters.
       This is a simplified kinematic chain with approximate link lengths.
       It maps joints to the joint indices used in the Arduino code. -->

  <link name="base_link">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.2 0.2 0.1"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 0.1"/>
      </geometry>
    </collision>
  </link>

  <!-- Torso -->
  <link name="torso_link">
    <visual>
      <geometry>
        <box size="0.25 0.18 0.35"/>
      </geometry>
    </visual>
  </link>

  <joint name="base_to_torso" type="fixed">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- Neck -->
  <link name="neck_link"/>
  <joint name="neck_joint" type="revolute">
    <parent link="torso_link"/>
    <child link="neck_link"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="5" velocity="1.0"/>
  </joint>

  <!-- Left leg chain: hip roll, hip pitch, knee -->
  <link name="l_hip_roll_link"/>
  <joint name="l_hip_roll" type="revolute">
    <parent link="torso_link"/>
    <child link="l_hip_roll_link"/>
    <origin xyz="0.08 0 -0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.785" upper="0.785" effort="50" velocity="2.0"/>
  </joint>

  <link name="l_hip_pitch_link"/>
  <joint name="l_hip_pitch" type="revolute">
    <parent link="l_hip_roll_link"/>
    <child link="l_hip_pitch_link"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.047" upper="1.047" effort="100" velocity="2.0"/>
  </joint>

  <link name="l_knee_link"/>
  <joint name="l_knee" type="revolute">
    <parent link="l_hip_pitch_link"/>
    <child link="l_knee_link"/>
    <origin xyz="0 -0.0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094" upper="0.0" effort="100" velocity="2.0"/>
  </joint>

  <link name="l_foot_link">
    <visual>
      <geometry>
        <box size="0.12 0.06 0.02"/>
      </geometry>
    </visual>
  </link>
  <joint name="l_ankle_fixed" type="fixed">
    <parent link="l_knee_link"/>
    <child link="l_foot_link"/>
    <origin xyz="0 -0.0 -0.18" rpy="0 0 0"/>
  </joint>

  <!-- Right leg chain (mirror) -->
  <link name="r_hip_roll_link"/>
  <joint name="r_hip_roll" type="revolute">
    <parent link="torso_link"/>
    <child link="r_hip_roll_link"/>
    <origin xyz="-0.08 0 -0.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.785" upper="0.785" effort="50" velocity="2.0"/>
  </joint>

  <link name="r_hip_pitch_link"/>
  <joint name="r_hip_pitch" type="revolute">
    <parent link="r_hip_roll_link"/>
    <child link="r_hip_pitch_link"/>
    <origin xyz="0 0 -0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.047" upper="1.047" effort="100" velocity="2.0"/>
  </joint>

  <link name="r_knee_link"/>
  <joint name="r_knee" type="revolute">
    <parent link="r_hip_pitch_link"/>
    <child link="r_knee_link"/>
    <origin xyz="0 -0.0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094" upper="0.0" effort="100" velocity="2.0"/>
  </joint>

  <link name="r_foot_link">
    <visual>
      <geometry>
        <box size="0.12 0.06 0.02"/>
      </geometry>
    </visual>
  </link>
  <joint name="r_ankle_fixed" type="fixed">
    <parent link="r_knee_link"/>
    <child link="r_foot_link"/>
    <origin xyz="0 -0.0 -0.18" rpy="0 0 0"/>
  </joint>

  <!-- Left arm (shoulder, elbow) -->
  <link name="l_shoulder_link"/>
  <joint name="l_shoulder" type="revolute">
    <parent link="torso_link"/>
    <child link="l_shoulder_link"/>
    <origin xyz="0.12 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="2.0"/>
  </joint>

  <link name="l_elbow_link"/>
  <joint name="l_elbow" type="revolute">
    <parent link="l_shoulder_link"/>
    <child link="l_elbow_link"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.0" effort="20" velocity="2.0"/>
  </joint>

  <link name="l_hand_link">
    <visual>
      <geometry>
        <box size="0.06 0.04 0.02"/>
      </geometry>
    </visual>
  </link>
  <joint name="l_wrist_fixed" type="fixed">
    <parent link="l_elbow_link"/>
    <child link="l_hand_link"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
  </joint>

  <!-- Right arm -->
  <link name="r_shoulder_link"/>
  <joint name="r_shoulder" type="revolute">
    <parent link="torso_link"/>
    <child link="r_shoulder_link"/>
    <origin xyz="-0.12 0 0.15" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="2.0"/>
  </joint>

  <link name="r_elbow_link"/>
  <joint name="r_elbow" type="revolute">
    <parent link="r_shoulder_link"/>
    <child link="r_elbow_link"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0" upper="2.0" effort="20" velocity="2.0"/>
  </joint>

  <link name="r_hand_link"/>
  <joint name="r_wrist_fixed" type="fixed">
    <parent link="r_elbow_link"/>
    <child link="r_hand_link"/>
    <origin xyz="0 0 -0.12" rpy="0 0 0"/>
  </joint>

</robot>
